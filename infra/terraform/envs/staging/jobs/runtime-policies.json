{
  "pellum-stg-job-dispatcher": {
    "scope": "stg",
    "runtime": "dispatcher",
    "policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "sqs:SendMessage"
          ],
          "Resource": [
            "arn:aws:sqs:us-east-2:792394000571:pellum-stg-pipeline",
            "arn:aws:sqs:us-east-2:792394000571:pellum-stg-notifications"
          ]
        },
        {
          "Effect": "Allow",
          "Action": [
            "cloudwatch:PutMetricData"
          ],
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "cloudwatch:namespace": [
                "Pellum/StagingJobs/stg/pipeline",
                "Pellum/StagingJobs/stg/notifications"
              ]
            }
          }
        }
      ]
    }
  },
  "pellum-stg-job-pipeline-worker": {
    "scope": "stg",
    "runtime": "pipeline-worker",
    "policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "sqs:ChangeMessageVisibility",
            "sqs:DeleteMessage",
            "sqs:ReceiveMessage"
          ],
          "Resource": [
            "arn:aws:sqs:us-east-2:792394000571:pellum-stg-pipeline"
          ]
        },
        {
          "Effect": "Allow",
          "Action": [
            "cloudwatch:PutMetricData"
          ],
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "cloudwatch:namespace": [
                "Pellum/StagingJobs/stg/pipeline"
              ]
            }
          }
        }
      ]
    }
  },
  "pellum-stg-job-notifications-worker": {
