              "Condition": {
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            },
            {
              "Sid": "ReadNamedVercelProvider",
              "Effect": "Allow",
              "Action": [
                "iam:GetOpenIDConnectProvider",
                "iam:ListOpenIDConnectProviderTags"
              ],
              "Resource": "arn:aws:iam::792394000571:oidc-provider/oidc.vercel.com/data-analyst-mike",
              "Condition": {
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            },
            {
              "Sid": "CreateOhioQuarantineBucket",
              "Effect": "Allow",
              "Action": [
                "s3:CreateBucket"
              ],
              "Resource": "arn:aws:s3:::pellum-stg-quarantine-792394000571-us-east-2",
              "Condition": {
                "StringEquals": {
                  "s3:LocationConstraint": "us-east-2"
                },
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            },
            {
              "Sid": "ConfigureOnlyQuarantine",
              "Effect": "Allow",
              "Action": [
                "s3:PutBucketTagging",
                "s3:PutBucketPolicy",
                "s3:PutBucketPublicAccessBlock",
                "s3:PutBucketOwnershipControls",
                "s3:PutEncryptionConfiguration",
                "s3:PutBucketCORS",
                "s3:PutLifecycleConfiguration"
              ],
              "Resource": "arn:aws:s3:::pellum-stg-quarantine-792394000571-us-east-2",
              "Condition": {
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            },
            {
              "Sid": "CreateOnlyBoundedUploadRoles",
              "Effect": "Allow",
              "Action": [
                "iam:CreateRole"
              ],
              "Resource": [
                "arn:aws:iam::792394000571:role/pellum-stg-upload-signer",
                "arn:aws:iam::792394000571:role/pellum-preview-upload-signer"
              ],
              "Condition": {
                "StringEquals": {
                  "iam:PermissionsBoundary": "arn:aws:iam::792394000571:policy/pellum-stg-upload-boundary"
                },
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            },
            {
              "Sid": "ConfigureOnlyUploadRoles",
              "Effect": "Allow",
              "Action": [
                "iam:TagRole",
                "iam:PutRolePolicy"
              ],
              "Resource": [
                "arn:aws:iam::792394000571:role/pellum-stg-upload-signer",
                "arn:aws:iam::792394000571:role/pellum-preview-upload-signer"
              ],
              "Condition": {
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            },
            {
              "Sid": "CreateNamedVercelProvider",
              "Effect": "Allow",
              "Action": [
                "iam:CreateOpenIDConnectProvider",
                "iam:TagOpenIDConnectProvider"
              ],
              "Resource": "arn:aws:iam::792394000571:oidc-provider/oidc.vercel.com/data-analyst-mike",
              "Condition": {
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            }
          ]
        }
      }
    }
  }
}
