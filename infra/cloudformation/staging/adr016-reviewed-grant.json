      "Type": "AWS::IAM::Policy",
      "Condition": "StagingAccountAndRegion",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Exact physical role and ARNs are required to prevent granting authority to another environment. Existing bootstrap owns the ceiling and role; this grant cannot modify either.",
          "must": [
            "No deletion, role passing, boundary editing, state access, object contents or unrelated resource grants.",
            "Expires automatically at the explicit UTC deadline. Apply only the reviewed saved plan."
          ]
        }
      },
      "Properties": {
        "PolicyName": "apply-reviewed-adr016-storage-plan",
        "Roles": [
          "pellum-stg-terraform-deploy"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ReadNamedQuarantineConfiguration",
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketTagging",
                "s3:GetBucketPolicy",
                "s3:GetBucketPublicAccessBlock",
                "s3:GetBucketOwnershipControls",
                "s3:GetEncryptionConfiguration",
                "s3:GetBucketCORS",
                "s3:GetLifecycleConfiguration",
                "s3:GetBucketVersioning",
                "s3:GetBucketAcl",
                "s3:GetAccelerateConfiguration",
                "s3:GetBucketRequestPayment",
                "s3:GetBucketWebsite",
                "s3:GetReplicationConfiguration",
                "s3:GetBucketLogging",
                "s3:GetBucketObjectLockConfiguration",
                "s3:ListBucket"
              ],
              "Resource": "arn:aws:s3:::pellum-stg-quarantine-792394000571-us-east-2",
              "Condition": {
                "DateLessThan": {
                  "aws:CurrentTime": "2026-09-13T22:00:00Z"
                }
              }
            },
            {
              "Sid": "ReadTwoUploadRoles",
              "Effect": "Allow",
              "Action": [
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListRolePolicies",
                "iam:ListAttachedRolePolicies",
                "iam:ListInstanceProfilesForRole",
                "iam:ListRoleTags"
              ],
              "Resource": [
                "arn:aws:iam::792394000571:role/pellum-stg-upload-signer",
                "arn:aws:iam::792394000571:role/pellum-preview-upload-signer"
