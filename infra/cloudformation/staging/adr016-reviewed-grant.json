{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Time-bounded deployment grant intersected with a verified immutable ceiling for one reviewed staging storage plan.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@2"
    },
    "ReviewedPlan": {
      "sha256": "7c553fe2df069921c9cd201f947e0df8a6b54356e4aae02c4edbacbcc1db46c7",
