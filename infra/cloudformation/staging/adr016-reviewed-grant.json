    "com.aws.cloudformation.Context": {
      "ref": [
        {
          "at": "docs/architecture/adr/ADR-016-staging-quarantine-federation.md",
          "has": "Approved staging-only conditions"
        }
      ]
    }
  },
  "Conditions": {
    "StagingAccountAndRegion": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::AccountId"
            },
            "792394000571"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "us-east-2"
          ]
        }
      ]
    }
  },
  "Resources": {
