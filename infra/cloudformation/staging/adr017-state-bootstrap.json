    "StableRuntimeBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "StagingAccountAndRegion",
      "Properties": {
        "ManagedPolicyName": "pellum-stg-job-runtime-boundary",
        "Description": "Immutable stg messaging and bounded telemetry ceiling; no queue/IAM administration.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sqs:ChangeMessageVisibility",
                "sqs:DeleteMessage",
                "sqs:ReceiveMessage",
                "sqs:SendMessage"
              ],
              "Resource": [
                "arn:aws:sqs:us-east-2:792394000571:pellum-stg-pipeline",
                "arn:aws:sqs:us-east-2:792394000571:pellum-stg-notifications"
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "cloudwatch:PutMetricData"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "cloudwatch:namespace": [
                    "Pellum/StagingJobs/stg/pipeline",
                    "Pellum/StagingJobs/stg/notifications"
                  ]
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Prevent a future runtime policy from escaping its environment queue namespace or bounded telemetry namespaces.",
          "must": [
            "No IAM, queue administration, purge, DLQ replay, other-environment queue access or persistent credentials.",
            "Deployment role cannot edit or remove this boundary."
          ]
        }
      }
    },
