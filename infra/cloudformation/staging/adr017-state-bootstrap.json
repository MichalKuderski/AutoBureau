              }
            },
            {
              "Sid": "NeverDeleteStateVersions",
              "Effect": "Deny",
              "Principal": "*",
              "Action": [
                "s3:DeleteObject",
                "s3:DeleteObjectVersion"
              ],
              "Resource": "arn:aws:s3:::pellum-stg-jobs-tfstate-792394000571-us-east-2/adr017/jobs.tfstate"
            }
          ]
        }
      }
    },
