// AutoBureau data model — implements docs/architecture/02-data-model.md as amended by
// the principal-panel review (A-F1 freshness, A-F2 obligation direction, A-F3 outcome
// capture, A-B8 entitlements) and scoped to PRD v1.
//
// DELIBERATELY ABSENT (PRD v1 §9 postponements — do not add without a §21 amendment):
//   conversations / messages  — no chat in v1 (search only)
//   task_runs / approvals     — no agent execution in v1 (Action Kits are templates)
// Their architecture is reviewed and parked in doc 04; empty tables are not free.

// `binaryTargets` is a consequence of doc 09 §9's deployment topology, not a Prisma
// preference. GitHub Actions is the only deployment authority — `vercel.json` sets
// `github.enabled: false` — so `vercel build` runs on an Ubuntu runner and
// `vercel deploy --prebuilt` uploads that output to Vercel's RHEL-based Node runtime.
// `native` alone therefore bakes in `debian-openssl-3.0.x`, the runner's engine, and the
// deployed function fails at Prisma initialisation with:
//
//     Prisma Client could not locate the Query Engine for runtime "rhel-openssl-3.0.x"
//
// It fails in a way nothing upstream can see. The engine never loads, so no connection is
// ever attempted: `auth_rate_limits` stayed empty because the limiter caught this and
// failed open, the database logged nothing because nothing reached it, and the smoke suite
// scored 17/17 because no check it makes touches a database. Every symptom that looked like
// a pooler or credential problem was this.
//
// `native` stays first so local development and the integration suites keep using the host's
// own engine; `rhel-openssl-3.0.x` is the deployed one and is additive.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// ─────────────────────────── identity & tenancy ───────────────────────────

enum UserStatus {
  active
  suspended
  deletion_pending
}

model User {
  id        String     @id @db.Uuid
  email     String     @unique
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile          UserProfile?
  memberships      HouseholdUser[]
  members          HouseholdMember[]
  createdHouseholds Household[]      @relation("household_creator")
  idempotencyKeys  IdempotencyKey[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  locale      String   @default("en-US")
  timezone    String   @default("America/New_York")
  country     String   @default("US") @db.Char(2)
  onboarding  Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Household {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  createdBy  String   @map("created_by") @db.Uuid
  emailAlias String?  @unique @map("email_alias")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator     User              @relation("household_creator", fields: [createdBy], references: [id])
  users       HouseholdUser[]
  members     HouseholdMember[]
  documents   Document[]
  items       Item[]
  obligations Obligation[]
  exportArtifacts LocalExportArtifact[]
  entitlement Entitlement?
  idempotencyKeys IdempotencyKey[]
  notifications Notification[]

  @@map("households")
  jobDeliveries JobDelivery[]
  accountChallenges AccountSecurityChallenge[]
  stripeTestBinding StripeTestBinding?
  stripeTestNotices StripeTestNotice[]
  stripeTestStates StripeTestState[]

 stripeTestIntents StripeTestIntent[]
}

/// Local account-security challenge consumption. No OTP, TOTP seed or token.
model AccountSecurityChallenge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String @map("household_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  factorId String @map("factor_id") @db.Uuid
  challengeId String @unique @map("challenge_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  household Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  @@index([householdId])
  @@map("account_security_challenges")
}

enum IdempotencyState {
  in_flight
  completed
}

/// Authentication rate-limit counters (ADR-013, blueprint P1-08).
///
/// GLOBAL AND ANONYMOUS BY CONSTRUCTION. The only table in this schema written by a
/// request that has no principal and no household: a sign-in attempt is counted before
/// any token is verified. It therefore carries no `household_id`, no `user_id`, and no
/// foreign key to anything — a reference to `users` would turn "this address attempted a
/// sign-in" into a joinable fact about a real account (ADR-013 D3).
///
/// `bucket` is a SHA-256 of the policy-domain-separated, normalized subject. That is NOT
/// secrecy: an email's preimage space is small and enumerable, so the digest is reversible
/// with a wordlist. It exists so this table never becomes a second plaintext corpus of
/// addresses, not to keep a secret it cannot keep — see ADR-013 D3 for exactly what it
/// does and does not protect against.
///
/// Reached only through `Database.withGlobalTable`, which establishes no tenant GUC at all.
model AuthRateLimit {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Policy identifier, e.g. `sign_in.identifier_ip`. A class, never a subject.
  policy String @db.VarChar(64)
  /// SHA-256 hex of `policy \0 normalized-subject`. Never a raw email or IP.
  bucket String @db.Char(64)
  /// Request time floored to the policy's window length, so a window maps to one row.
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  attempts        Int      @default(0)
  /// Authoritative for expiry: a lapsed row is treated as absent whether or not it has
  /// been swept (ADR-013 D11). Correctness never depends on a cleaner running.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  /// What makes the increment atomic: one `INSERT … ON CONFLICT DO UPDATE` both records
  /// the attempt and reports the running total, with no read-modify-write window.
  @@unique([policy, bucket, windowStartedAt])
  /// Serves the opportunistic expiry sweep.
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

/// Server-side idempotency records (ADR-011 D13, ADR-012).
///
/// INFRASTRUCTURE, NOT DOMAIN DATA. Written only by the `/v1` request boundary and read
/// only by it; no endpoint exposes these rows, and nothing joins to them. They are here
/// rather than in Redis because Redis is provisioned in no deployed environment (ADR-012).
///
/// `response_body` holds a completed response verbatim, so a row can contain whatever
/// household data that endpoint returned. It is therefore scoped by RLS to *both* the
/// household and the principal that created it — stricter than every other table, because
/// a replay is an answer to one person's request, not the household's shared state.
model IdempotencyKey {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String           @map("household_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  /// Client-supplied and opaque; 1–255 characters (ADR-011 D13).
  key             String           @db.VarChar(255)
  method          String           @db.VarChar(16)
  /// Request target: pathname plus query string.
  path            String
  /// SHA-256 hex of the canonical `idempotencyFingerprintInput` payload.
  fingerprint     String           @db.Char(64)
  state           IdempotencyState
  responseStatus  Int?             @map("response_status")
  responseBody    String?          @map("response_body")
  responseHeaders Json?            @map("response_headers")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The uniqueness that makes the claim atomic. Household and principal are part of the
  /// key, so one principal's key can never collide with — or replay — another's.
  @@unique([householdId, userId, key])
  @@index([householdId, userId, expiresAt])
  @@map("idempotency_keys")
}

enum HouseholdRole {
  owner
  member
  viewer
}

/// Who may ACCESS a household (login accounts).
model HouseholdUser {
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
  @@map("household_users")
}

enum MemberKind {
  adult
  child
  dependent
  pet
  entity
}

/// WHOSE paperwork this is. Distinct from HouseholdUser: a dependent parent is a
/// member with no login. The caregiver wedge depends on this separation (PRD §4).
model HouseholdMember {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String     @map("household_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  displayName String     @map("display_name")
  kind        MemberKind
  dateOfBirth DateTime?  @map("date_of_birth") @db.Date
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       Item[]
  obligations Obligation[]

  @@index([householdId])
  @@map("household_members")
}

// ─────────────────────────── billing entitlements (A-B8) ───────────────────────────

enum PlanTier {
  free
  premium
}

/// Free-tier caps are load-bearing for unit economics (doc 14 §4) — enforced in
/// code against these rows, never assumed.
model Entitlement {
  householdId       String   @id @map("household_id") @db.Uuid
  plan              PlanTier @default(free)
  docsPerMonth      Int      @default(10) @map("docs_per_month")
  membersMax        Int      @default(2) @map("members_max")
  periodStart       DateTime @map("period_start") @db.Date
  docsUsedThisPeriod Int     @default(0) @map("docs_used_this_period")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

// ─────────────────────────── documents ───────────────────────────

enum DocSource {
  upload
  email
  api
}

enum DocStatus {
  queued
  received
  scanning
  processing
  needs_review
  processed
  rejected
  failed
  discarded
}

model Document {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId  String     @map("household_id") @db.Uuid
  uploadedBy   String?    @map("uploaded_by") @db.Uuid
  source       DocSource
  storagePath  String     @map("storage_path")
  mimeType     String     @map("mime_type")
  sizeBytes    BigInt     @map("size_bytes")
  sha256       Bytes?     // Set only after hashing actual quarantined bytes.
  status       DocStatus  @default(received)
  docType      String?    @map("doc_type")
  confidence   Decimal?   @db.Decimal(4, 3)
  title        String?
  docDate      DateTime?  @map("doc_date") @db.Date
  extracted    Json?
  review       Json?
  error        Json?
  processedAt  DateTime?  @map("processed_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  upload    DocumentUpload?
  chunks    DocumentChunk[]
  items     Item[]

  @@unique([householdId, sha256])
  /// SQL-owned tenant-parity FKs prevent cross-household referential effects.
  @@unique([id, householdId])
  @@index([householdId, status])
  @@index([householdId, docType, docDate])
  @@map("documents")
}

/// Upload capability metadata is separate from trusted processed document metadata.
/// Tenant access is derived through the parent document's forced-RLS policy.
model DocumentUpload {
  documentId  String    @id @map("document_id") @db.Uuid
  objectKey   String    @unique @map("object_key") @db.VarChar(300)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("document_uploads")
}

/// A3/F-05: NO vector index at launch. Retrieval is exact KNN inside one household
/// (btree prefilter on household_id + ORDER BY embedding <=> $q). Revisit past
/// ~50k chunks/household (doc 14).
model DocumentChunk {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String                       @map("document_id") @db.Uuid
  householdId String                       @map("household_id") @db.Uuid
  seq         Int
  content     String
  embedding   Unsupported("vector(1024)")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, seq])
  @@index([householdId])
  @@map("document_chunks")
}

// ─────────────────────────── registry ───────────────────────────

enum VendorKind {
  insurer
  government
  subscription
  utility
  retailer
  other
}

/// The only global (non-household) table. Seed of the Ledger-B rulebook (A-B2/A-F4).
model Vendor {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  kind     VendorKind
  country  String     @default("US") @db.Char(2)
  region   String?
  domains  String[]   @default([])
  metadata Json       @default("{}")

  items Item[]

  @@index([name])
  @@map("vendors")
}

enum ItemKind {
  passport
  drivers_license
  vehicle_registration
  vehicle
  insurance_policy
  subscription
  warranty
  membership
  certification
  lease
  loan
  utility_account
  tax_year
  benefit_plan
  medical_account
  other
}

enum ItemStatus {
  active
  expiring
  expired
  cancelled
  archived
}

model Item {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      String     @map("household_id") @db.Uuid
  memberId         String?    @map("member_id") @db.Uuid
  kind             ItemKind
  name             String
  status           ItemStatus @default(active)
  vendorId         String?    @map("vendor_id") @db.Uuid
  vendorName       String?    @map("vendor_name")
  attrs            Json       @default("{}")
  amountCents      BigInt?    @map("amount_cents")
  currency         String?    @db.Char(3)
  billingCycle     String?    @map("billing_cycle")
  validFrom        DateTime?  @map("valid_from") @db.Date
  expiresAt        DateTime?  @map("expires_at") @db.Date
  /// A-F1 freshness doctrine: when a human last confirmed these facts.
  verifiedAt       DateTime?  @map("verified_at") @db.Timestamptz(6)
  sourceDocumentId String?    @map("source_document_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  household      Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member         HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  vendor         Vendor?          @relation(fields: [vendorId], references: [id])
  sourceDocument Document?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  secrets        ItemSecret[]
  obligations    Obligation[]

  /// SQL-owned tenant-parity FKs prevent cross-household referential effects.
  @@unique([id, householdId])
  @@index([householdId, kind])
  @@index([householdId, expiresAt])
  @@map("items")
}

/// ADR-007: identifier-grade PII quarantined here. Ciphertext only; the AI runtime
/// holds no KMS decrypt grant and never reads this table.
model ItemSecret {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId     String @map("item_id") @db.Uuid
  field      String
  ciphertext Bytes
  keyVersion Int    @map("key_version")
  last4      String?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, field])
  @@map("item_secrets")
}

// ─────────────────────────── obligations ───────────────────────────

enum ObligationKind {
  renewal
  payment
  cancellation_window
  filing
  claim
  enrollment
  appointment
  custom
}

enum ObligationStatus {
  upcoming
  action_needed
  in_progress
  waiting
  done
  dismissed
  missed
}

/// A-F2: the ledger runs both directions. `owed_to_household` is the entitlement
/// half (warranties, deposits, unclaimed refunds) — the found-money loop.
enum ObligationDirection {
  owed_by_household
  owed_to_household
}

enum ObligationSource {
  ai
  user
  system
}

model Obligation {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      String              @map("household_id") @db.Uuid
  itemId           String?             @map("item_id") @db.Uuid
  memberId         String?             @map("member_id") @db.Uuid
  title            String
  kind             ObligationKind
  direction        ObligationDirection @default(owed_by_household)
  status           ObligationStatus    @default(upcoming)
  priority         Int                 @default(2) @db.SmallInt
  dueAt            DateTime            @map("due_at") @db.Timestamptz(6)
  windowStart      DateTime?           @map("window_start") @db.Timestamptz(6)
  graceUntil       DateTime?           @map("grace_until") @db.Timestamptz(6)
  amountCents      BigInt?             @map("amount_cents")
  currency         String?             @db.Char(3)
  recurrence       String?
  source           ObligationSource
  sourceDocumentId String?             @map("source_document_id") @db.Uuid
  aiConfidence     Decimal?            @map("ai_confidence") @db.Decimal(4, 3)
  /// A-F3: Ledger B's feed — what actually happened when this closed.
  outcome          Json?
  verifiedAt       DateTime?           @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item      Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member    HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  /// SQL-owned tenant-parity FKs prevent cross-household referential effects.
  @@unique([id, householdId])
  @@index([householdId, status, dueAt])
  @@map("obligations")
}

enum ReminderStatus {
  scheduled
  sent
  skipped
  cancelled
}

// ─────────────────────────── notification ledger ───────────────────────────

enum NotificationChannel {
  email
  push
  inapp
}

enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  bounced
  failed
  suppressed
}

model Notification {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String @map("household_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  kind        String @db.VarChar(80)
  title       String @db.VarChar(300)
  body        String @db.VarChar(2000)
  targetType  String? @map("target_type") @db.VarChar(32)
  targetId    String? @map("target_id") @db.Uuid
  dedupeKey   String @map("dedupe_key") @db.VarChar(200)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([householdId, userId, dedupeKey])
  @@index([householdId, userId, createdAt, id])
  @@index([userId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(queued)
  providerMessageId String? @map("provider_message_id") @db.VarChar(255)
  availableAt    DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts       Int @default(0)
  leaseToken     String? @map("lease_token") @db.Uuid
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  errorCode      String? @map("error_code") @db.VarChar(80)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, availableAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  userId  String @map("user_id") @db.Uuid
  kind    String @db.VarChar(80)
  channel NotificationChannel
  enabled Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, channel])
  @@map("notification_preferences")
}

/// Reminders are materialized rows so the scheduler is an indexed scan (doc 07 §5)
/// and snoozing is a row update. They double as freshness probes (H11).
model Reminder {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  obligationId String         @map("obligation_id") @db.Uuid
  householdId  String         @map("household_id") @db.Uuid
  remindAt     DateTime       @map("remind_at") @db.Timestamptz(6)
  offsetLabel  String         @map("offset_label")
  status       ReminderStatus @default(scheduled)
  sentAt       DateTime?      @map("sent_at") @db.Timestamptz(6)

  obligation Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([obligationId, offsetLabel])
  @@index([status, remindAt])
  @@map("reminders")
}

// ─────────────────────────── platform ───────────────────────────

/// ADR-005: the only bridge from transactions to async work. Written in the same
/// transaction as the domain change; a dispatcher publishes it. Never dual-write.
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  householdId   String?   @map("household_id") @db.Uuid
  payload       Json
  traceparent   String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

