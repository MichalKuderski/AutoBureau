{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Model selects existing slots; it cannot invent dates, money, citations or confidence. Local semantic validation is mandatory.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "typed-candidates-draft-1"
      ]
    },
    "docType": {
      "type": "string",
      "enum": [
        "government_id",
        "insurance_policy",
        "medical_bill",
        "vehicle_registration",
        "lease",
        "utility_bill",
        "warranty",
        "subscription_receipt"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "requires-human-review"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "amount_due",
              "cancel_by_date",
              "claim_deadline",
              "credit_amount",
              "deposit_amount",
              "deposit_return_date",
              "effective_date",
              "end_date",
              "expiry_date",
              "issue_date",
              "paid_amount",
              "payment_due_date",
              "period_end",
              "period_start",
              "premium_amount",
              "purchase_date",
              "refund_amount",
              "renewal_amount",
              "renewal_date",
              "rent_amount",
              "service_date",
              "start_date",
              "statement_date"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "missing",
              "ambiguous",
              "conflicting"
            ]
          },
          "sourceSlots": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "role",
          "status",
          "sourceSlots"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "version",
    "docType",
    "decision",
    "fields"
  ],
  "additionalProperties": false
}
